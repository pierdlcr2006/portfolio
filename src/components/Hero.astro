---
import { profile } from '../data/portfolio';
---

<section class="hero container" id="home" aria-labelledby="hero-title">
	<div class="hero-intro">
		<p data-i18n data-es={`Hola, soy ${profile.name}`} data-en={`Hi, I'm ${profile.name}`}>Hola, soy {profile.name}</p>
	</div>

	<div class="hero-main">
		<h1 id="hero-title"><span data-i18n data-es="Desarrollador" data-en="Software">Desarrollador</span><br /><span data-i18n data-es="de Software" data-en="Developer">de Software</span></h1>
		<div class="hero-description">
			<p data-i18n data-es={profile.summary} data-en={profile.summaryEn}>{profile.summary}</p>
			<div class="social-links" aria-label="Enlaces profesionales">
				<a class="social-link" href={profile.linkedin} target="_blank" rel="noreferrer" aria-label="LinkedIn de Piero de la Cruz Palpa" data-label-es="LinkedIn de Piero de la Cruz Palpa" data-label-en="Piero de la Cruz Palpa on LinkedIn">
					<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5.2 3.5a2.2 2.2 0 1 1-4.4 0 2.2 2.2 0 0 1 4.4 0ZM1.1 8h4.2v12.5H1.1V8Zm6.8 0h4v1.7h.1c.6-1.1 2-2.2 4-2.2 4.3 0 5.1 2.8 5.1 6.5v6.5h-4.2v-5.8c0-1.4 0-3.3-2-3.3s-2.3 1.5-2.3 3.2v5.9H7.9V8Z" /></svg>
				</a>
			</div>
		</div>
	</div>
</section>

<style>
	.hero {
		padding-top: clamp(8rem, 16vh, 11rem);
		padding-bottom: clamp(2.5rem, 5vw, 4rem);
	}

	.hero-intro {
		margin-bottom: 1.25rem;
		color: var(--color-text-muted);
		font-size: clamp(0.95rem, 1.7vw, 1.15rem);
	}

	.hero-intro p {
		margin: 0;
	}

	.hero-main {
		display: grid;
		grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
		gap: clamp(2rem, 5vw, 4rem);
		align-items: center;
	}

	h1 {
		margin: 0;
		color: var(--color-text);
		font-size: clamp(2.8rem, 4.5vw, 4.8rem);
		font-weight: 500;
		letter-spacing: -0.11em;
		line-height: 0.94;
	}

	.hero-description {
		max-width: 56ch;
	}

	.hero-description p {
		margin: 0;
		color: var(--color-text-secondary);
		font-size: clamp(0.95rem, 1.7vw, 1.15rem);
		line-height: 1.75;
	}

	.social-links {
		display: flex;
		gap: 0.8rem;
		margin-top: 2rem;
	}

	.social-link {
		display: grid;
		place-items: center;
		width: 54px;
		height: 54px;
		border: 1px solid var(--color-border);
		border-radius: var(--radius-md);
		color: var(--color-text-secondary);
		transition: border-color var(--transition-fast), color var(--transition-fast), transform var(--transition-fast);
	}

	.social-link:hover {
		transform: translateY(-2px);
		border-color: var(--color-accent);
		color: var(--color-accent);
	}

	.social-link svg {
		width: 22px;
		height: 22px;
		fill: currentColor;
	}

	.social-link:nth-child(2) svg {
		fill: none;
		stroke: currentColor;
		stroke-linecap: round;
		stroke-linejoin: round;
		stroke-width: 1.6;
	}

	@media (max-width: 760px) {
		.hero {
			padding-top: 8rem;
			padding-bottom: 2.5rem;
		}

		.hero-main {
			grid-template-columns: 1fr;
			gap: 2.25rem;
		}

		h1 {
			font-size: clamp(3.1rem, 16vw, 5.8rem);
		}

	}
</style>
