---
import { profile } from '../data/portfolio';
import { getLang, useTranslations } from '../i18n/utils';

const t = useTranslations(getLang(Astro.currentLocale));
---

<section class="hero container" id="home" aria-labelledby="hero-title">
	<div class="hero-intro">
		<p>{t('hero.greeting', { name: profile.name })}</p>
	</div>

	<div class="hero-main">
		<h1 id="hero-title"><span>{t('hero.title1')}</span><br /><span>{t('hero.title2')}</span></h1>
		<div class="hero-description">
			<img class="profile-photo" src="/profile-image.png" alt={t('hero.photoAlt', { name: profile.name })} width="320" height="320" loading="eager" decoding="async" />
			<div class="social-links" aria-label={t('hero.socialAria')}>
				<a class="social-link" href={profile.linkedin} target="_blank" rel="noreferrer" aria-label={t('hero.linkedinLabel', { name: profile.name })}>
					<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5.2 3.5a2.2 2.2 0 1 1-4.4 0 2.2 2.2 0 0 1 4.4 0ZM1.1 8h4.2v12.5H1.1V8Zm6.8 0h4v1.7h.1c.6-1.1 2-2.2 4-2.2 4.3 0 5.1 2.8 5.1 6.5v6.5h-4.2v-5.8c0-1.4 0-3.3-2-3.3s-2.3 1.5-2.3 3.2v5.9H7.9V8Z" /></svg>
				</a>
				<a class="social-link" href={profile.github} target="_blank" rel="noreferrer" aria-label={t('hero.githubLabel', { name: profile.name })}>
					<img src="https://svgl.app/library/github_dark.svg" alt="" width="22" height="22" aria-hidden="true" loading="eager" decoding="async" />
				</a>
			</div>
		</div>
	</div>
</section>

<style>
	.hero {
		padding-top: clamp(8rem, 16vh, 11rem);
		padding-bottom: clamp(2.5rem, 5vw, 4rem);
	}

	.hero-intro {
		margin-bottom: 1.25rem;
		color: var(--color-text-muted);
		font-size: clamp(0.95rem, 1.7vw, 1.15rem);
	}

	.hero-intro p {
		margin: 0;
	}

	.hero-main {
		display: grid;
		grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
		gap: clamp(2rem, 5vw, 4rem);
		align-items: center;
	}

	h1 {
		margin: 0;
		color: var(--color-text);
		font-size: clamp(2.8rem, 4.5vw, 4.8rem);
		font-weight: 500;
		letter-spacing: -0.11em;
		line-height: 0.94;
	}

	.hero-description {
		max-width: 56ch;
	}

	.profile-photo {
		display: block;
		width: clamp(190px, 24vw, 300px);
		height: auto;
		aspect-ratio: 1;
		margin-inline: auto;
		border: 1px solid var(--color-border);
		border-radius: 50%;
		object-fit: cover;
		box-shadow: 0 0 0 8px rgba(169, 255, 91, 0.035), 0 18px 55px rgba(0, 0, 0, 0.28);
	}

	.social-links {
		display: flex;
		justify-content: center;
		gap: 0.8rem;
		margin-top: 2rem;
	}

	.social-link {
		display: grid;
		place-items: center;
		width: 54px;
		height: 54px;
		border: 1px solid var(--color-border);
		border-radius: var(--radius-md);
		color: var(--color-text-secondary);
		transition: border-color var(--transition-fast), color var(--transition-fast), transform var(--transition-fast);
	}

	.social-link:hover {
		transform: translateY(-2px);
		border-color: var(--color-accent);
		color: var(--color-accent);
	}

	.social-link svg {
		width: 22px;
		height: 22px;
		fill: currentColor;
	}

	.social-link img {
		width: 22px;
		height: 22px;
		object-fit: contain;
	}

	.social-link:nth-child(2) svg {
		fill: none;
		stroke: currentColor;
		stroke-linecap: round;
		stroke-linejoin: round;
		stroke-width: 1.6;
	}

	@media (max-width: 760px) {
		.hero {
			padding-top: 8rem;
			padding-bottom: 2.5rem;
		}

		.hero-main {
			grid-template-columns: 1fr;
			gap: 2.25rem;
		}

		h1 {
			font-size: clamp(3.1rem, 16vw, 5.8rem);
		}

	}
</style>
