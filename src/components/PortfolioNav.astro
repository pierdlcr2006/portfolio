---
import { Toggle } from '@starwind-ui/astro/toggle';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { getLang, useTranslations } from '../i18n/utils';

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);
---

<a class="skip-link" href="#contenido">{t('nav.skip')}</a>

<div class="nav-shell">
	<nav id="main-nav" aria-label={t('nav.aria')}>
		<button
			id="menu-toggle"
			class="menu-toggle"
			type="button"
			aria-expanded="false"
			aria-controls="nav-menu"
			aria-label={t('nav.openMenu')}
			data-label-open={t('nav.openMenu')}
			data-label-close={t('nav.closeMenu')}
		>
			<span class="menu-toggle-bar" aria-hidden="true"></span>
			<span class="menu-toggle-bar" aria-hidden="true"></span>
			<span class="menu-toggle-bar" aria-hidden="true"></span>
		</button>
		<ul id="nav-menu">
			<li>
				<a href="#home">
					<span class="nav-indicator" aria-hidden="true"></span>
					<span class="nav-icon" aria-hidden="true">
						<svg viewBox="0 0 24 24"><path d="M21 20c0 .55-.45 1-1 1H4c-.55 0-1-.45-1-1V9.49c0-.31.14-.6.39-.79l8-6.22a1 1 0 0 1 1.23 0l8 6.22c.24.19.39.48.39.79V20ZM19 19V9.98L12 4.53 5 9.98V19h14Z" /></svg>
					</span>
					<span class="nav-label">{t('nav.home')}</span>
				</a>
			</li>
			<li>
				<a href="#projects">
					<span class="nav-indicator" aria-hidden="true"></span>
					<span class="nav-icon" aria-hidden="true">
						<svg viewBox="0 0 24 24"><path d="M4 5v14h16V7h-8.41l-2-2H4Zm8.41 0H21c.55 0 1 .45 1 1v14c0 .55-.45 1-1 1H3c-.55 0-1-.45-1-1V4c0-.55.45-1 1-1h7.41l2 2Z" /></svg>
					</span>
					<span class="nav-label">{t('nav.projects')}</span>
				</a>
			</li>
			<li>
				<a href="#contact">
					<span class="nav-indicator" aria-hidden="true"></span>
					<span class="nav-icon" aria-hidden="true">
						<svg viewBox="0 0 24 24"><path d="M21.73 2.96 16.27 22.04c-.15.53-.48.55-.72.07L11 13 1.92 9.37c-.51-.2-.5-.51.03-.69l19.09-6.36c.53-.18.83.12.69.64ZM19.04 5.1 6.81 9.17l5.64 2.25 3.04 6.08L19.04 5.1Z" /></svg>
					</span>
					<span class="nav-label">{t('nav.contact')}</span>
				</a>
			</li>
			<li class="language-item">
				<Toggle.Root
					id="language-toggle"
					class="language-toggle"
					defaultPressed={lang === 'en'}
					data-language={lang}
					data-url-es={getRelativeLocaleUrl('es')}
					data-url-en={getRelativeLocaleUrl('en')}
					aria-label={t('nav.switchLanguage')}
				>
					<span class="language-option language-option-es" aria-hidden="true">ES</span>
					<span class="language-divider" aria-hidden="true">/</span>
					<span class="language-option language-option-en" aria-hidden="true">EN</span>
				</Toggle.Root>
			</li>
		</ul>
	</nav>
</div>

<script>
	const nav = document.getElementById('main-nav');
	const menuToggle = document.getElementById('menu-toggle');
	const desktopQuery = window.matchMedia('(min-width: 768px)');
	const maxScroll = 1000;
	let rafId: number | null = null;

	function updateNav() {
		if (!nav) return;

		if (window.scrollY > 0) {
			nav.classList.add('scrolling');
			const scrollProgress = Math.min(window.scrollY / maxScroll, 1);
			const easeProgress = 1 - Math.pow(1 - scrollProgress, 4);
			const minWidth = 528;
			const maxWidth = window.innerWidth * 0.8;
			const currentWidth = maxWidth - (maxWidth - minWidth) * easeProgress;

			if (desktopQuery.matches) nav.style.setProperty('width', `${currentWidth}px`);
			else nav.style.removeProperty('width');
		} else {
			nav.classList.remove('scrolling');
			nav.style.removeProperty('width');
		}
		rafId = null;
	}

	window.addEventListener(
		'scroll',
		() => {
			if (!rafId) rafId = requestAnimationFrame(updateNav);
		},
		{ passive: true },
	);
	window.addEventListener('resize', updateNav);

	// Menú hamburguesa (móvil)
	const setMenuOpen = (open: boolean) => {
		if (!nav || !menuToggle) return;
		nav.classList.toggle('menu-open', open);
		document.documentElement.classList.toggle('menu-open', open);
		document.querySelectorAll<HTMLElement>('main, footer').forEach((element) => {
			element.inert = open;
		});
		menuToggle.setAttribute('aria-expanded', String(open));
		menuToggle.setAttribute('aria-label', (open ? menuToggle.dataset.labelClose : menuToggle.dataset.labelOpen) ?? '');
	};
	const isMenuOpen = () => menuToggle?.getAttribute('aria-expanded') === 'true';

	menuToggle?.addEventListener('click', () => setMenuOpen(!isMenuOpen()));

	// Cerrar al tocar fuera del menú
	document.addEventListener('click', (event) => {
		if (isMenuOpen() && nav && !nav.contains(event.target as Node)) setMenuOpen(false);
	});

	// Cerrar con Escape devolviendo el foco al botón
	document.addEventListener('keydown', (event) => {
		if (event.key === 'Escape' && isMenuOpen()) {
			setMenuOpen(false);
			menuToggle?.focus();
		}
	});

	// Cerrar si el foco sale del menú (navegación con teclado)
	nav?.addEventListener('focusout', (event) => {
		const next = event.relatedTarget as Node | null;
		if (next && !nav.contains(next)) setMenuOpen(false);
	});

	// Al pasar a escritorio el menú vuelve a su estado normal
	desktopQuery.addEventListener('change', (event) => {
		if (event.matches) setMenuOpen(false);
		updateNav();
	});

	document.querySelectorAll<HTMLAnchorElement>('a[href^="#"]').forEach((anchor) => {
		anchor.addEventListener('click', (event) => {
			event.preventDefault();
			setMenuOpen(false);
			const targetId = anchor.getAttribute('href')?.substring(1) ?? '';
			document.getElementById(targetId)?.scrollIntoView({ behavior: 'smooth' });
		});
	});

	const navLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>('#main-nav a[href^="#"]'));
	const navigableSections = navLinks
		.map((link) => document.querySelector<HTMLElement>(link.getAttribute('href') ?? ''))
		.filter((section): section is HTMLElement => section !== null);
	let activeSectionRaf: number | null = null;

	const updateActiveSection = () => {
		const activationLine = window.innerHeight * 0.38;
		let activeSection = navigableSections[0];

		for (const section of navigableSections) {
			if (section.getBoundingClientRect().top <= activationLine) activeSection = section;
		}

		navLinks.forEach((link) => {
			link.classList.toggle('active', link.getAttribute('href') === `#${activeSection?.id}`);
		});
		activeSectionRaf = null;
	};

	const scheduleActiveSectionUpdate = () => {
		if (activeSectionRaf === null) activeSectionRaf = requestAnimationFrame(updateActiveSection);
	};

	window.addEventListener('scroll', scheduleActiveSectionUpdate, { passive: true });
	window.addEventListener('resize', scheduleActiveSectionUpdate);
	updateActiveSection();

	// Cambio de idioma: carga la versión del sitio en el otro idioma (/ ↔ /en/),
	// conservando la sección en la que está el usuario.
	const languageToggle = document.querySelector<HTMLElement>('#language-toggle');

	languageToggle?.addEventListener('starwind:pressed-change', (event) => {
		const { pressed } = (event as CustomEvent<{ pressed: boolean }>).detail;
		const destination = pressed ? languageToggle.dataset.urlEn : languageToggle.dataset.urlEs;
		if (!destination) return;

		const activeHash = navLinks.find((link) => link.classList.contains('active'))?.getAttribute('href');
		window.location.assign(activeHash && activeHash !== '#home' ? `${destination}${activeHash}` : destination);
	});

	updateNav();
</script>

<style>
	.skip-link {
		position: fixed;
		top: 0.75rem;
		left: 0.75rem;
		z-index: 200;
		transform: translateY(-160%);
		padding: 0.65rem 0.8rem;
		border-radius: var(--radius-sm);
		background: var(--color-accent);
		color: var(--color-bg);
		font-size: 0.75rem;
		text-decoration: none;
		transition: transform var(--transition-fast);
	}

	.skip-link:focus {
		transform: translateY(0);
	}

	.nav-shell {
		display: flex;
		justify-content: center;
		width: 100%;
	}

	nav {
		position: fixed;
		top: 1.5rem;
		left: 50%;
		z-index: 100;
		width: 80%;
		transform: translateX(-50%);
		border: 1px solid transparent;
		background: transparent;
		backdrop-filter: blur(18px);
		transition: background-color 0.3s ease, border-radius 0.3s ease, border-color 0.3s ease, width 0.5s ease;
	}

	nav.scrolling {
		border-color: rgba(255, 255, 255, 0.06);
		border-radius: 9999px;
		background: rgba(16, 16, 16, 0.86);
	}

	ul {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 3rem;
		width: 100%;
		max-width: 1024px;
		margin: 0 auto;
		padding: 0.75rem 1rem;
		list-style: none;
	}

	li {
		flex: 0 1 auto;
	}

	.language-item {
		margin-left: 0.5rem;
	}

	a {
		position: relative;
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 0.35rem;
		color: var(--color-text-muted);
		font-size: 0.9rem;
		text-decoration: none;
		transition: color var(--transition-fast);
	}

	a:hover,
	a.active {
		color: var(--color-text);
	}

	.nav-indicator {
		position: absolute;
		left: -1.5rem;
		top: 50%;
		width: 0.5rem;
		height: 0.5rem;
		transform: translateY(-50%) scale(0);
		border-radius: 50%;
		background: var(--color-accent);
		opacity: 0;
		transition: transform var(--transition-fast), opacity var(--transition-fast);
	}

	a.active .nav-indicator {
		transform: translateY(-50%) scale(1);
		opacity: 1;
	}

	.language-toggle {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-width: 4.5rem;
		min-height: 2rem;
		padding: 0.35rem 0.55rem;
		border: 1px solid rgba(255, 255, 255, 0.12);
		border-radius: 999px;
		background: transparent;
		color: var(--color-text-muted);
		font: inherit;
		font-size: 0.62rem;
		line-height: 1;
		cursor: pointer;
		transition: color var(--transition-fast), border-color var(--transition-fast), background-color var(--transition-fast);
	}

	.language-toggle:hover,
	.language-toggle:focus-visible {
		border-color: var(--color-accent);
		color: var(--color-text);
	}

	.language-option {
		transition: color var(--transition-fast), font-weight var(--transition-fast);
	}

	.language-toggle[data-language='es'] .language-option-es,
	.language-toggle[data-language='en'] .language-option-en {
		color: var(--color-accent);
		font-weight: 700;
	}

	.language-divider {
		color: var(--color-text-muted);
	}

	.nav-icon {
		display: none;
		width: 1.5rem;
		height: 1.5rem;
	}

	.nav-icon svg {
		width: 100%;
		height: 100%;
		fill: currentColor;
	}

	.menu-toggle {
		display: none;
	}

	@media (max-width: 767px) {
		nav,
		nav.scrolling {
			top: 0.75rem;
			right: 0.75rem;
			left: auto;
			width: auto;
			transform: none;
			border: 0;
			border-radius: 0;
			background: transparent;
			backdrop-filter: none;
		}

		.menu-toggle {
			position: relative;
			display: block;
			width: 2.75rem;
			height: 2.75rem;
			margin-left: auto;
			padding: 0;
			border: 1px solid rgba(255, 255, 255, 0.06);
			border-radius: 50%;
			background: rgba(16, 16, 16, 0.94);
			backdrop-filter: blur(18px);
			color: var(--color-text);
			cursor: pointer;
			transition: border-color var(--transition-fast);
		}

		.menu-toggle:hover,
		.menu-toggle[aria-expanded='true'] {
			border-color: var(--color-accent);
		}

		.menu-toggle-bar {
			position: absolute;
			top: 50%;
			left: 50%;
			width: 1.1rem;
			height: 2px;
			margin: -1px 0 0 -0.55rem;
			border-radius: 2px;
			background: currentColor;
			transition: transform var(--transition-fast), opacity var(--transition-fast);
		}

		.menu-toggle-bar:nth-child(1) {
			transform: translateY(-5px);
		}

		.menu-toggle-bar:nth-child(3) {
			transform: translateY(5px);
		}

		.menu-toggle[aria-expanded='true'] .menu-toggle-bar:nth-child(1) {
			transform: rotate(45deg);
		}

		.menu-toggle[aria-expanded='true'] .menu-toggle-bar:nth-child(2) {
			opacity: 0;
		}

		.menu-toggle[aria-expanded='true'] .menu-toggle-bar:nth-child(3) {
			transform: rotate(-45deg);
		}

		#nav-menu {
			position: fixed;
			inset: 0;
			z-index: 1;
			flex-direction: column;
			align-items: stretch;
			justify-content: flex-start;
			gap: 0;
			width: 100%;
			max-width: none;
			margin: 0;
			padding: 5.5rem var(--page-gutter) 2rem;
			overflow-y: auto;
			overscroll-behavior: contain;
			background: var(--color-bg);
			visibility: hidden;
			opacity: 0;
			pointer-events: none;
			transition: opacity var(--transition-standard), visibility 0s linear var(--transition-standard);
		}

		nav.menu-open #nav-menu {
			visibility: visible;
			opacity: 1;
			pointer-events: auto;
			transition-delay: 0s;
		}

		:global(html.menu-open) {
			overflow: hidden;
		}

		.menu-toggle {
			z-index: 2;
		}

		li {
			flex: none;
			border-bottom: 1px solid rgba(255, 255, 255, 0.06);
		}

		a {
			justify-content: flex-start;
			gap: 1rem;
			min-height: 4.5rem;
			padding: 0;
			font-size: clamp(1.5rem, 8vw, 2.25rem);
			letter-spacing: -0.04em;
		}

		.nav-icon {
			display: flex;
			width: 1.75rem;
			height: 1.75rem;
		}

		.nav-indicator {
			left: auto;
			right: 0;
		}

		.language-item {
			margin: auto 0 0;
			padding-top: 1.5rem;
			border-top: 1px solid rgba(255, 255, 255, 0.06);
			border-bottom: 0;
		}

		.language-toggle {
			min-width: 6rem;
			min-height: 3rem;
			font-size: 0.8rem;
		}
	}
</style>
