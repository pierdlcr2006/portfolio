---
import { services } from '../data/portfolio';
import { getLang, useTranslations } from '../i18n/utils';
import CodeEditor from './CodeEditor.astro';

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);
---

<section class="services section" id="services" aria-labelledby="services-title">
	<div class="container services-layout">
		<div class="services-list">
			<p class="section-kicker">{t('services.kicker')}</p>
			<h2 id="services-title">{t('services.title')}</h2>
			<ul class="capabilities-list" aria-label={t('services.listAria')}>
				{services.map((service) => (
					<li class="capability-item">
						<span class="capability-marker" aria-hidden="true"></span>
						<span>{lang === 'en' ? service.titleEn : service.title}</span>
					</li>
				))}
			</ul>
		</div>

		<div class="service-visual">
			<CodeEditor />
		</div>
	</div>
</section>

<style>
	.services {
		padding-top: clamp(2rem, 4vw, 3rem);
		background: transparent;
	}

	.services-layout {
		display: flex;
		flex-direction: column;
		gap: 2rem;
		align-items: center;
	}

	.services-list {
		width: 100%;
	}

	.section-kicker {
		margin: 0 0 0.75rem;
		color: var(--color-accent-secondary);
		font-size: 0.72rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	h2 {
		margin: 0 0 2.5rem;
		font-size: clamp(2rem, 5vw, 3rem);
		font-weight: 500;
		letter-spacing: -0.06em;
		line-height: 1;
	}

	.capabilities-list {
		display: grid;
		gap: 1rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.capability-item {
		display: flex;
		align-items: center;
		gap: 0.85rem;
		min-height: 68px;
		padding: 1rem 1.15rem;
		border: 1px solid var(--color-border);
		border-radius: 1rem;
		background: rgba(20, 20, 20, 0.61);
		color: var(--color-text-secondary);
		font-size: 0.92rem;
		transition: border-color var(--transition-standard), background-color var(--transition-standard), color var(--transition-standard);
	}

	.capability-item:hover {
		border-color: var(--color-border-strong);
		background: var(--color-surface);
		color: var(--color-text);
	}

	.capability-marker {
		width: 0.45rem;
		height: 0.45rem;
		flex: 0 0 auto;
		border-radius: 50%;
		color: var(--color-accent-secondary);
		background: currentColor;
		box-shadow: 0 0 10px rgba(169, 255, 91, 0.25);
	}

	.service-visual {
		display: flex;
		width: 330px;
		height: 330px;
		align-items: center;
		justify-content: center;
		padding-top: 0.75rem;
	}

	@media (min-width: 960px) {
		.services-layout {
			display: grid;
			grid-template-columns: minmax(0, 1fr) 330px;
			align-items: center;
			gap: 2rem;
		}

		.service-visual {
			margin-left: 1rem;
		}
	}
</style>
