---
import { selectedWork } from '../data/portfolio';

const timelineWork = [...selectedWork].sort((a, b) => b.startDate.localeCompare(a.startDate));
---

<section id="projects" class="projects section" aria-labelledby="projects-title">
	<div class="container">
		<p class="section-kicker" data-i18n data-es="Mi trabajo" data-en="My work">Mi trabajo</p>
		<h2 class="section-accent" data-i18n data-es="Experiencia" data-en="Experience">Experiencia</h2>
		<h3 id="projects-title" data-i18n data-es="Trayectoria profesional" data-en="Professional experience">Trayectoria profesional</h3>

		<div class="projects-timeline">
			{timelineWork.map((work) => (
				<article class="project-card">
					<div class="project-date">
						<span class="timeline-date" data-i18n data-es={work.period} data-en={work.periodEn}>{work.period}</span>
					</div>
					<div class="timeline-marker" aria-hidden="true"></div>
					<div class="project-content">
						<p class="project-company">{work.company}</p>
						<div class="project-details">
							<h4 data-i18n data-es={work.title} data-en={work.titleEn}>{work.title}</h4>
							<span data-i18n data-es={work.role} data-en={work.roleEn}>{work.role}</span>
						</div>
						<p class="project-description" data-i18n data-es={work.description} data-en={work.descriptionEn}>{work.description}</p>
						<div class="project-tags">
							{work.tags.map((tag) => <span>{tag}</span>)}
						</div>
					</div>
				</article>
			))}
		</div>
	</div>
</section>

<style>
	.projects {
		border-top: 1px solid rgba(255, 255, 255, 0.06);
	}

	.section-kicker {
		margin: 0 0 0.5rem;
		color: var(--color-accent-secondary);
		font-size: 0.72rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	.section-accent {
		margin: 0 0 0.4rem;
		background: linear-gradient(135deg, #a476ff 25%, #eee5ff 50%, #a476ff 75%);
		background-size: 400% 100%;
		-webkit-background-clip: text;
		background-clip: text;
		color: transparent;
		font-size: 1.1rem;
		font-weight: 500;
		animation: shine 3s linear infinite;
	}

	h3 {
		margin: 0 0 2.2rem;
		font-size: clamp(2.3rem, 5vw, 3.5rem);
		font-weight: 500;
		letter-spacing: -0.08em;
		line-height: 1;
	}

	.projects-timeline {
		position: relative;
		display: grid;
		gap: 3rem;
		max-width: 980px;
		margin-inline: auto;
	}

	.projects-timeline::before {
		position: absolute;
		top: 1.25rem;
		bottom: 1.25rem;
		left: 50%;
		width: 1px;
		transform: translateX(-50%);
		background: rgba(169, 255, 91, 0.24);
		content: '';
	}

	.project-card {
		display: grid;
		grid-template-columns: minmax(0, 1fr) 2rem minmax(0, 1fr);
		grid-template-areas: 'content marker date';
		column-gap: 1.5rem;
		align-items: start;
		min-width: 0;
	}

	.project-card:nth-child(even) {
		grid-template-areas: 'date marker content';
	}

	.project-date {
		grid-area: date;
		align-self: start;
		padding-top: 0.25rem;
	}

	.project-card:nth-child(even) .project-date {
		text-align: right;
	}

	.timeline-date {
		color: var(--color-text-muted);
		font-size: 0.68rem;
		line-height: 1.6;
	}

	.timeline-marker {
		grid-area: marker;
		position: relative;
		z-index: 1;
		display: grid;
		place-items: start center;
		padding-top: 0.35rem;
	}

	.timeline-marker::before {
		width: 0.75rem;
		height: 0.75rem;
		border: 2px solid var(--color-accent);
		border-radius: 50%;
		background: var(--color-bg);
		box-shadow: 0 0 0 4px rgba(169, 255, 91, 0.08);
		content: '';
	}

	.project-content {
		grid-area: content;
		min-width: 0;
		padding-block: 0.25rem;
	}

	.project-company {
		margin: 0 0 0.7rem;
		color: var(--color-accent-secondary);
		font-size: 0.68rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	.project-details {
		padding-inline: 0;
	}

	h4 {
		margin: 0;
		font-size: clamp(1.15rem, 2.3vw, 1.45rem);
		font-weight: 600;
		line-height: 1.2;
	}

	.project-details span {
		display: block;
		margin-top: 0.35rem;
		color: var(--color-text-muted);
		font-size: 0.7rem;
	}

	.project-description {
		margin: 0.9rem 0 0;
		padding-inline: 0;
		color: var(--color-text-muted);
		font-size: 0.76rem;
		line-height: 1.6;
	}

	.project-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
		margin-top: 0.9rem;
		padding-inline: 0;
	}

	.project-tags span {
		padding: 0.3rem 0.45rem;
		border: 1px solid rgba(255, 255, 255, 0.1);
		border-radius: 999px;
		color: var(--color-text-muted);
		font-size: 0.62rem;
		transition: transform var(--transition-fast), border-color var(--transition-fast), background-color var(--transition-fast), color var(--transition-fast), box-shadow var(--transition-fast);
	}

	.project-tags span:hover {
		transform: translateY(-1px);
		border-color: var(--color-accent);
		background: rgba(169, 255, 91, 0.08);
		color: var(--color-accent);
		box-shadow: 0 0 14px rgba(169, 255, 91, 0.12);
	}

	@keyframes shine {
		0% {
			background-position: 100% 50%;
		}

		30%,
		70% {
			background-position: 0% 50%;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.section-accent {
			animation: none;
		}
	}

	@media (max-width: 680px) {
		.projects-timeline {
			gap: 2rem;
		}

		.projects-timeline::before {
			left: 0.7rem;
			transform: none;
		}

		.project-card {
			grid-template-columns: 1.5rem minmax(0, 1fr);
			grid-template-areas: 'marker date' 'marker content';
			row-gap: 0.6rem;
			column-gap: 1rem;
		}

		.project-card:nth-child(even) {
			grid-template-areas: 'marker date' 'marker content';
		}

		.project-date {
			padding-top: 0;
			text-align: left;
		}

	}
</style>
