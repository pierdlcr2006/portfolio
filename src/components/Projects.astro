---
import { selectedWork } from '../data/portfolio';
---

<section id="projects" class="projects section" aria-labelledby="projects-title">
	<div class="container">
		<p class="section-kicker" data-i18n data-es="Mi trabajo" data-en="My work">Mi trabajo</p>
		<h2 class="section-accent" data-i18n data-es="Experiencia" data-en="Experience">Experiencia</h2>
		<h3 id="projects-title" data-i18n data-es="Trayectoria profesional" data-en="Professional experience">Trayectoria profesional</h3>

		<div class="projects-grid">
			{selectedWork.map((work, index) => (
				<article class="project-card">
					<div class:list={['project-preview', `project-preview-${index + 1}`]} aria-hidden="true">
						<div class="preview-topline">
							<span>{work.company}</span>
						</div>
						<div class="preview-grid"></div>
						<div class="preview-terminal">
							<span>{work.tags.slice(0, 2).join(' / ')}</span>
							<span aria-hidden="true">{`{ }`}</span>
						</div>
					</div>
					<div class="project-details">
						<div>
							<h4 data-i18n data-es={work.title} data-en={work.titleEn}>{work.title}</h4>
							<span data-i18n data-es={work.role} data-en={work.roleEn}>{work.role}</span>
						</div>
						<span class="project-status" data-i18n data-es={work.period} data-en={work.periodEn}>{work.period}</span>
					</div>
					<p class="project-description" data-i18n data-es={work.description} data-en={work.descriptionEn}>{work.description}</p>
					<div class="project-tags">
						{work.tags.map((tag) => <span>{tag}</span>)}
					</div>
				</article>
			))}
		</div>
	</div>
</section>

<style>
	.projects {
		border-top: 1px solid rgba(255, 255, 255, 0.06);
	}

	.section-kicker {
		margin: 0 0 0.5rem;
		color: var(--color-accent-secondary);
		font-size: 0.72rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	.section-accent {
		margin: 0 0 0.4rem;
		background: linear-gradient(135deg, #a476ff 25%, #eee5ff 50%, #a476ff 75%);
		background-size: 400% 100%;
		-webkit-background-clip: text;
		background-clip: text;
		color: transparent;
		font-size: 1.1rem;
		font-weight: 500;
		animation: shine 3s linear infinite;
	}

	h3 {
		margin: 0 0 2.2rem;
		font-size: clamp(2.3rem, 5vw, 3.5rem);
		font-weight: 500;
		letter-spacing: -0.08em;
		line-height: 1;
	}

	.projects-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 2rem;
	}

	.project-card {
		min-width: 0;
	}

	.project-preview {
		position: relative;
		height: 18rem;
		margin-bottom: 1rem;
		overflow: hidden;
		border: 1px solid rgba(255, 255, 255, 0.08);
		border-radius: 1rem;
		background: #161616;
		box-shadow: 0 16px 35px rgba(0, 0, 0, 0.22);
		transition: box-shadow var(--transition-standard), transform var(--transition-standard);
	}

	.project-card:hover .project-preview {
		box-shadow: 0 22px 44px rgba(0, 0, 0, 0.38);
		transform: translateY(-3px);
	}

	.project-preview-1 {
		background: radial-gradient(circle at 75% 25%, rgba(164, 118, 255, 0.28), transparent 34%), #16131d;
	}

	.project-preview-2 {
		background: radial-gradient(circle at 30% 70%, rgba(169, 255, 91, 0.14), transparent 33%), #141816;
	}

	.project-preview-3 {
		background: radial-gradient(circle at 75% 70%, rgba(164, 118, 255, 0.2), transparent 33%), #161616;
	}

	.preview-topline {
		position: absolute;
		top: 1rem;
		right: 1rem;
		left: 1rem;
		display: flex;
		justify-content: space-between;
		color: rgba(245, 245, 240, 0.58);
		font-size: 0.65rem;
		text-transform: uppercase;
	}

	.preview-grid {
		position: absolute;
		inset: 3.2rem 1rem 1rem;
		background:
			linear-gradient(rgba(255, 255, 255, 0.06) 1px, transparent 1px) 0 0 / 100% 2rem,
			linear-gradient(90deg, rgba(255, 255, 255, 0.06) 1px, transparent 1px) 0 0 / 2rem 100%;
		opacity: 0.65;
	}

	.preview-terminal {
		position: absolute;
		right: 1.25rem;
		bottom: 1.25rem;
		left: 1.25rem;
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 0.7rem 0.8rem;
		border: 1px solid rgba(255, 255, 255, 0.11);
		border-radius: 0.55rem;
		background: rgba(16, 16, 16, 0.78);
		color: var(--color-accent);
		font-size: 0.66rem;
		backdrop-filter: blur(9px);
	}

	.project-details {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: 1rem;
		padding-inline: 0.75rem;
	}

	h4 {
		margin: 0;
		font-size: clamp(1.15rem, 2.3vw, 1.45rem);
		font-weight: 600;
		line-height: 1.2;
	}

	.project-details span {
		display: block;
		margin-top: 0.35rem;
		color: var(--color-text-muted);
		font-size: 0.7rem;
	}

	.project-status {
		max-width: 15ch;
		margin-top: 0 !important;
		text-align: right;
	}

	.project-description {
		margin: 0.9rem 0 0;
		padding-inline: 0.75rem;
		color: var(--color-text-muted);
		font-size: 0.76rem;
		line-height: 1.6;
	}

	.project-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
		margin-top: 0.9rem;
		padding-inline: 0.75rem;
	}

	.project-tags span {
		padding: 0.3rem 0.45rem;
		border: 1px solid rgba(255, 255, 255, 0.1);
		border-radius: 999px;
		color: var(--color-text-muted);
		font-size: 0.62rem;
	}

	@keyframes shine {
		0% {
			background-position: 100% 50%;
		}

		30%,
		70% {
			background-position: 0% 50%;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.section-accent {
			animation: none;
		}
	}

	@media (max-width: 680px) {
		.projects-grid {
			grid-template-columns: 1fr;
			gap: 2.5rem;
		}

		.project-preview {
			height: 14rem;
		}
	}
</style>
