---
import { profile } from '../data/portfolio';
---

<section class="contact section" id="contact" aria-labelledby="contact-title">
	<div class="container contact-layout">
		<div class="contact-heading">
			<p class="section-kicker" data-i18n data-es="Hablemos" data-en="Let's talk">Hablemos</p>
			<h2 id="contact-title" data-i18n data-es="Contacto" data-en="Contact">Contacto</h2>
		</div>

		<div class="contact-body">
			<p class="contact-copy" data-i18n data-es="¿Tienes una idea, un producto o un proyecto en mente? Escríbeme y conversemos." data-en="Do you have an idea, a product, or a project in mind? Write to me and let's talk.">¿Tienes una idea, un producto o un proyecto en mente? Escríbeme y conversemos.</p>
			<p class="contact-location" data-i18n data-es="Disponible por LinkedIn o correo electrónico." data-en="Available on LinkedIn or email.">Disponible por LinkedIn o correo electrónico.</p>

			<div class="contact-links">
				<a href={profile.linkedin} target="_blank" rel="noreferrer">LinkedIn ↗</a>
				<a href={`mailto:${profile.email}`} data-i18n data-es="Enviar un correo ↗" data-en="Send an email ↗">Enviar un correo ↗</a>
			</div>
		</div>
	</div>
</section>

<style>
	.contact {
		background: rgba(255, 255, 255, 0.012);
	}

	.contact-layout {
		display: grid;
		grid-template-columns: minmax(240px, 0.7fr) minmax(0, 1.3fr);
		gap: clamp(3rem, 10vw, 10rem);
	}

	.section-kicker {
		margin: 0 0 0.75rem;
		color: var(--color-accent-secondary);
		font-size: 0.72rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	h2 {
		margin: 0;
		font-size: clamp(2.8rem, 4.5vw, 4.8rem);
		font-weight: 500;
		letter-spacing: -0.11em;
		line-height: 0.9;
	}

	.contact-body {
		max-width: 620px;
	}

	.contact-copy {
		margin: 0;
		color: var(--color-text-secondary);
		font-size: clamp(1rem, 1.7vw, 1.15rem);
		line-height: 1.7;
	}

	.contact-location {
		margin: 0.7rem 0 2.5rem;
		color: var(--color-text-muted);
		font-size: 0.75rem;
	}

	.contact-links {
		display: flex;
		flex-wrap: wrap;
		gap: 1.5rem;
		margin-top: 2.5rem;
		padding-top: 1.2rem;
		border-top: 1px solid var(--color-border);
		font-size: 0.72rem;
	}

	.contact-links a {
		padding: 0.55rem 0.75rem;
		border: 1px solid rgba(169, 255, 91, 0.28);
		border-radius: 999px;
		background: rgba(169, 255, 91, 0.04);
		color: var(--color-accent);
		font-weight: 600;
		text-decoration: none;
		transition: transform var(--transition-fast), border-color var(--transition-fast), background-color var(--transition-fast), box-shadow var(--transition-fast);
	}

	.contact-links a:hover {
		transform: translateY(-1px);
		border-color: var(--color-accent);
		background: rgba(169, 255, 91, 0.1);
		box-shadow: 0 0 14px rgba(169, 255, 91, 0.12);
	}

	@media (max-width: 760px) {
		.contact-layout {
			grid-template-columns: 1fr;
			gap: 3rem;
		}
	}
</style>
