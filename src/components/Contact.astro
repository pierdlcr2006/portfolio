---
import { profile } from '../data/portfolio';
import { getLang, useTranslations } from '../i18n/utils';

const t = useTranslations(getLang(Astro.currentLocale));
---

<section class="contact section" id="contact" aria-labelledby="contact-title">
	<div class="container contact-layout">
		<div class="contact-heading">
			<p class="section-kicker">{t('contact.kicker')}</p>
			<h2 id="contact-title">{t('contact.title')}</h2>
		</div>

		<div class="contact-body">
			<p class="contact-copy">{t('contact.copy')}</p>
			<p class="contact-location">{t('contact.availability')}</p>

			<div class="contact-links">
				<a href={profile.linkedin} target="_blank" rel="noreferrer">LinkedIn ↗</a>
				<a href={`mailto:${profile.email}`}>{t('contact.email')}</a>
			</div>
		</div>
	</div>
</section>

<style>
	.contact {
		background: rgba(255, 255, 255, 0.012);
	}

	.contact-layout {
		display: grid;
		grid-template-columns: minmax(240px, 0.7fr) minmax(0, 1.3fr);
		gap: clamp(3rem, 10vw, 10rem);
	}

	.section-kicker {
		margin: 0 0 0.75rem;
		color: var(--color-accent-secondary);
		font-size: 0.72rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	h2 {
		margin: 0;
		font-size: clamp(2.8rem, 4.5vw, 4.8rem);
		font-weight: 500;
		letter-spacing: -0.11em;
		line-height: 0.9;
	}

	.contact-body {
		max-width: 620px;
	}

	.contact-copy {
		margin: 0;
		color: var(--color-text-secondary);
		font-size: clamp(1rem, 1.7vw, 1.15rem);
		line-height: 1.7;
	}

	.contact-location {
		margin: 0.7rem 0 2.5rem;
		color: var(--color-text-muted);
		font-size: 0.75rem;
	}

	.contact-links {
		display: flex;
		flex-wrap: wrap;
		gap: 1.5rem;
		margin-top: 2.5rem;
		padding-top: 1.2rem;
		border-top: 1px solid var(--color-border);
		font-size: 0.72rem;
	}

	.contact-links a {
		color: var(--color-text-secondary);
		font-weight: 500;
		text-decoration-color: rgba(169, 255, 91, 0.45);
		text-underline-offset: 0.3rem;
		transition: transform var(--transition-fast), color var(--transition-fast), text-decoration-color var(--transition-fast);
	}

	.contact-links a:hover {
		transform: translateY(-1px);
		color: var(--color-accent);
		text-decoration-color: var(--color-accent);
	}

	@media (max-width: 760px) {
		.contact-layout {
			grid-template-columns: 1fr;
			gap: 3rem;
		}
	}
</style>
